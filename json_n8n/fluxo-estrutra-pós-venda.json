      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "servico",
              "name": "SERVICO",
              "type": "string",
              "value": "={{ (() => { const field = $json.custom_fields.find(c => c.name === 'Serviço'); if (!field) return 'Pesquisa de Mercado'; const opt = field.type_config?.options?.find(o => o.orderindex === field.value); return opt ? opt.name : 'Pesquisa de Mercado'; })() }}"
            },
            {
              "id": "nome-projeto",
              "name": "NOME_EMPRESA",
              "type": "string",
              "value": "={{ $json.custom_fields.find(c => c.name === 'Empresa' || c.name === 'Nome da Empresa')?.value || \"Doce Raiz Alimentos\" }}"
            },
            {
              "id": "dfccf1b3-5339-4c25-bd0e-06f5dec15869",
              "name": "CLIENTE",
              "value": "={{ $json.name }}",
              "type": "string"
            },
            {
              "id": "49ccefad-cc0a-4278-9a47-673c660e0a8e",
              "name": "PORTFOLIO",
              "value": "={{ $json.custom_fields.find(c => c.name === 'Categoria do Portifílio')?.type_config?.options?.find(o => o.orderindex === $json.custom_fields.find(c => c.name === 'Categoria do Portifílio')?.value)?.name || \"Estratégico\" }}",
              "type": "string"
            },
            {
              "id": "dab8c6c9-ca17-41d5-aa6a-18a4d3ab5534",
              "name": "COMPLEXIDADE",
              "value": "={{ $json.custom_fields.find(c => c.name === 'Complexidade')?.type_config?.options?.find(o => o.orderindex === $json.custom_fields.find(c => c.name === 'Complexidade')?.value)?.name || \"Média\" }}",
              "type": "string"
            },
            {
              "id": "51e67111-3ec7-4ad5-af26-1018125ed6a0",
              "name": "RESPONSAVEL_COMERCIAL",
              "value": "={{ $json.custom_fields.find(c => c.name === 'Responsável comercial')?.value?.[0]?.username || $json.creator.username }}",
              "type": "string"
            },
            {
              "id": "6d660628-535b-4725-9b1c-ed43e73753f2",
              "name": "DATA_INICIO",
              "value": "={{ $now.format('dd/MM/yyyy') }}",
              "type": "string"
            },
            {
              "id": "c40cc494-6e91-49e4-ad1d-f247098893c1",
              "name": "DATA_TERMINO",
              "value": "={{ (() => {\n  const campoData = $json.custom_fields.find(c => c.name === 'Prazo máximo desejado pelo cliente' && c.type === 'date');\n  if (!campoData || !campoData.value) return \"\";\n  const dataObj = new Date(Number(campoData.value));\n  return dataObj.toLocaleDateString('pt-BR');\n})() }}",
              "type": "string"
            },
            {
              "id": "81ac0feb-69ab-4ada-b467-3294db957f7d",
              "name": "CONTEXTO_EMPRESA",
              "value": "={{ $json.custom_fields.find(c => c.name === 'Contexto da empresa')?.value }}",
              "type": "string"
            },
            {
              "id": "ffc239c6-5524-4b73-95bd-aa7852dd0e27",
              "name": "PROBLEMA",
              "value": "={{ $json.custom_fields.find(c => c.name === 'Problema')?.value }}",
              "type": "string"
            },
            {
              "id": "ea33e4f0-e10c-4ebc-876a-c4535da6ffea",
              "name": "OBJETIVO_PROJETO",
              "value": "={{ $json.custom_fields.find(c => c.name === 'Objetivo do projeto')?.value }}",
              "type": "string"
            },
            {
              "id": "bf51a621-b50e-47e7-9065-3ffb4e285a9a",
              "name": "RESULTADOS_CHAVE",
              "value": "={{ $json.custom_fields.find(c => c.name === 'Resultados-chave esperados' && c.value)?.value }}",
              "type": "string"
            },
            {
              "id": "135b6ea2-7d38-44a2-bf73-4245bf4c1da0",
              "name": "INDICADORES",
              "value": "={{ $json.custom_fields.find(c => c.name === 'Indicadores que o cliente já acompanha')?.value }}",
              "type": "string"
            },
            {
              "id": "aab15fc6-fdc3-4df9-8092-defd9d7da690",
              "name": "=ENTREGAS_ESPERADAS",
              "value": "={{ $json.custom_fields.find(c => c.name === 'Entregas esperadas' && c.value)?.value }}",
              "type": "string"
            },
            {
              "id": "d27a94ab-eb56-48a3-a0eb-79b77b7de97d",
              "name": "FORA_ESCOPO",
              "value": "={{ $json.custom_fields.find(c => c.name === 'O que NÃO está incluído no escopo')?.value }}",
              "type": "string"
