    {
      "parameters": {
        "jsCode": "let eapOriginal = [];\ntry {\n  const prep = $('Preparar etapas da EAP').first().json;\n  eapOriginal = Array.isArray(prep.EAP_ARRAY) ? prep.EAP_ARRAY : [];\n} catch (e) {\n  eapOriginal = [];\n}\n\nlet estruturaEAP = [];\nlet macroAtual = null;\n\n// Varre dinamicamente e separa macroetapas de subetapas\neapOriginal.forEach(item => {\n  item = String(item).trim();\n  if (!item) return;\n\n  // Identifica se é macroetapa (número inteiro ex: \"1. \", \"2 - \") e não decimal (ex: \"1.1\")\n  const isMacro = /^\\d+\\s*[\\.\\-]\\s+[^\\.]/.test(item) && !/^\\d+\\.\\d+/.test(item);\n\n  if (isMacro) {\n    macroAtual = {\n      macro: item,\n      subetapas: []\n    };\n    estruturaEAP.push(macroAtual);\n  } else if (macroAtual) {\n    macroAtual.subetapas.push(item);\n  }\n});\n\n// Retorna para o n8n criar as pastas e as tarefas no ClickUp\nreturn estruturaEAP.map(item => ({ json: item }));"
      },
