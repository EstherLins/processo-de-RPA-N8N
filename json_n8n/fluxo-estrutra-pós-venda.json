            {
              "id": "17ed588a-057c-47f3-ae0f-83734b82a90f",
              "name": "COMBINADOS",
              "value": "={{ $json.custom_fields.find(c => c.name === 'Combinados')?.value }}",
              "type": "string"
            },
            {
              "id": "419504ea-a90f-4b7b-a99a-32db97496d73",
              "name": "FERRAMENTAS_CLIENTE",
              "value": "={{ $json.custom_fields.find(c => c.name === 'Ferramentas e sistemas do cliente')?.value }}",
              "type": "string"
            },
            {
              "id": "b4789016-3786-4223-bedd-38e81d6e8cec",
              "name": "DURACAO_DIAS",
              "value": "={{ Math.round((Math.abs(Number($json.custom_fields.find(c => c.name === 'Prazo máximo desejado pelo cliente' && c.type === 'date')?.value || 0) - Number($json.custom_fields.find(c => c.name === 'Início previsto' && c.type === 'date')?.value || 0)) / (1000 * 60 * 60 * 24)) * (5/7)) || 45 }}",
              "type": "string"
            }
          ]
        },
