    {
      "parameters": {
        "jsCode": "// 1. Pega os dados do arquivo que acabou de ser copiado no Google Drive\nconst arquivoCopiado = $('Copiar arquivo modelo').first().json;\n\n// 2. Pega o texto gerado pela IA\nconst out = $('Gerar texto do slide da proposta').first().json;\nlet raw = '';\nif (out.content && Array.isArray(out.content.parts)) {\n  raw = out.content.parts.map(p => p.text || '').join('');\n} else {\n  raw = out.text || out.message || out.output || out;\n}\n\nlet aiData = {};\nif (typeof raw === 'string') {\n  const fence = String.fromCharCode(96).repeat(3);\n  const cleaned = raw.split(fence + 'json').join('').split(fence).join('').trim();\n  const start = cleaned.indexOf('{');\n  const end = cleaned.lastIndexOf('}');\n  if (start !== -1 && end !== -1) {\n    aiData = JSON.parse(cleaned.slice(start, end + 1));\n  }\n} else {\n  aiData = raw;\n}\n\n// 3. Retorna o ID do arquivo (presentationId) junto com todos os campos da IA achatados\nreturn [{\n  json: {\n    presentationId: arquivoCopiado.id || arquivoCopiado.fileId,\n    NOME_PROJETO: aiData.NOME_PROJETO || \"\",\n    NOME_EMPRESA: aiData.NOME_EMPRESA || \"\",\n    DATA_PROPOSTA: aiData.DATA_PROPOSTA || \"\",\n    RESPONSAVEL_COMERCIAL: aiData.RESPONSAVEL_COMERCIAL || \"\",\n    OBJETIVO_PROJETO: aiData.OBJETIVO_PROJETO || \"\",\n    RESULTADOS_CHAVE: aiData.RESULTADOS_CHAVE || \"\",\n    INDICADORES: aiData.INDICADORES || \"\",\n    DATA_INICIO: aiData.DATA_INICIO || \"\",\n    DATA_TERMINO: aiData.DATA_TERMINO || \"\",\n    DURACAO_DIAS: String(aiData.DURACAO_DIAS || \"\"),\n    EAP_RESUMIDA: aiData.EAP_RESUMIDA || \"\",\n    VALOR_TOTAL: aiData.VALOR_TOTAL || \"\"\n  }\n}];"
      },
