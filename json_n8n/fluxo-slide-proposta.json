    {
      "parameters": {
        "jsCode": "const clean = (o) => {\n  const r = {};\n  for (const [k, v] of Object.entries(o)) {\n    if (k === 'row_number') continue;\n    if (v === '' || v === null || v === undefined) continue;\n    r[k] = v;\n  }\n  return r;\n};\nconst rows = (name) => $(name).all().map(i => i.json);\n\nconst eap = rows('Coletar dados da EAP')\n  .filter(r => String(r['NOME DA ETAPA'] || '').trim() !== '')\n  .map(clean);\nconst precificacao = rows('Coletar dados da PRECIFICAÇÃO')\n  .map(clean)\n  .filter(r => Object.keys(r).length > 0);\nconst cronograma = rows('Coletar dados do CRONOGRAMA')\n  .map(clean)\n  .filter(r => Object.keys(r).length > 0);\n\nconst t = $('Coletar dados da proposta').first().json;\nconst clickup = {\n  nome_tarefa: t.name,\n  descricao: t.description || t.text_content || '',\n  status: t.status && t.status.status,\n  data_inicio: t.start_date,\n  data_vencimento: t.due_date,\n  responsaveis: (t.assignees || []).map(a => a.username || a.email),\n  campos_personalizados: (t.custom_fields || [])\n    .map(f => ({ nome: f.name, valor: f.value }))\n    .filter(f => f.valor !== undefined && f.valor !== null && f.valor !== '')\n};\n\nreturn [{\n  json: {\n    clickup_info: clickup,\n    eap_completa: eap,\n    precificacao_completa: precificacao,\n    cronograma_completo: cronograma\n  }\n}];"
      },
      "id": "b7bd0217-ab55-4ab4-b1de-1f11d419bf0e",
